averagingNumMin       = 1                   
averagingPercentile   = 0.0000000e+000      
locationType          = 2d

[Spatial]
quantity            = initialtracerIM1 # Name of the quantity. See UM Section C.5.3
targetMaskFile      = para1.pol        # Name of <*.pol> file to be used as mask. Grid parts inside any polygon will receive the spatial forcing.
interpolationMethod = constant         # Type of (spatial) interpolation.
operand             = override         # How this data is combined with previous data for the same quantity (if any).
dataValue           = 10.0             # Constant value to be set inside all model points inside the polygon, used when no dataFile/dataFileType is specified. Requires targetMaskFile=*.pol and interpolationMethod=constant.

