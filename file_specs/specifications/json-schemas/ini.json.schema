{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "type": "object",
    "definitions": {
        "status": {
            "type": "object",
            "properties": {
                "value": {
                    "type": "string",
                    "enum": [
                        "GA",
                        "research",
                        "deprecated",
                        "obsolete"
                    ],
                    "default": "GA"
                },
                "comment": {
                    "type": "string"
                },
                "since_release": {
                    "type": "number"
                },
                "date": {
                    "$comment": "Use format YYYY-mm-dd",
                    "type": "string",
                    "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
                }
            },
            "required": [
                "value"
            ],
            "allOf": [
                {
                    "if": {
                        "properties": {
                            "value": {
                                "const": "obsolete"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "comment",
                            "since_release"
                        ]
                    }
                },
                {
                    "if": {
                        "properties": {
                            "value": {
                                "const": "deprecated"
                            }
                        }
                    },
                    "then": {
                        "required": [
                            "comment",
                            "date"
                        ]
                    }
                }
            ],
            "additionalProperties": false
        }
    },
    "properties": {
        "file_version": {
            "type": "string"
        },
        "file_format_version": {
            "type": "string"
        },
        "file_format_type": {
            "type": "string",
            "enum": [
                "ini"
            ]
        },
        "description": {
            "type": "string"
        },
        "ini_sections": {
            "type": "array",
            "items": {
                "type": "object",
                "properties": {
                    "name": {
                        "type": "string"
                    },
                    "description": {
                        "type": "string"
                    },
                    "is_unique": {
                        "type": "boolean"
                    },
                    "ini_properties": {
                        "type": "array",
                        "items": {
                            "type": "object",
                            "properties": {
                                "key": {
                                    "type": "string"
                                },
                                "default_value": {},
                                "value_type": {
                                    "type": "string",
                                    "enum": [
                                        "string",
                                        "int",
                                        "float",
                                        "intbool",
                                        "path",
                                        "enum",
                                        "intenum",
                                        "list[path]",
                                        "list[string]",
                                        "list[float]",
                                        "datetime"
                                    ]
                                },
                                "description": {
                                    "type": "string"
                                },
                                "status": {
                                    "$ref": "#/definitions/status"
                                },
                                "validation": {
                                    "type": "object",
                                    "properties": {
                                        "min_length": {
                                            "type": "integer"
                                        },
                                        "max_length": {
                                            "type": "integer"
                                        },
                                        "length_dependency": {
                                            "type": "string"
                                        },
                                        "is_required": {
                                            "type": "boolean"
                                        },
                                        "range": {
                                            "type": "object",
                                            "properties": {
                                                "min_inclusive": {
                                                    "type": "number"
                                                },
                                                "max_inclusive": {
                                                    "type": "number"
                                                },
                                                "min_exclusive": {
                                                    "type": "number"
                                                },
                                                "max_exclusive": {
                                                    "type": "number"
                                                }
                                            }
                                        }
                                    },
                                    "additionalProperties": false
                                },
                                "enum_values": {
                                    "type": "object",
                                    "additionalProperties": {
                                        "oneOf": [
                                            {
                                                "type": "string"
                                            },
                                            {
                                                "type": "object",
                                                "properties": {
                                                    "description": {
                                                        "type": "string"
                                                    },
                                                    "status": {
                                                        "$ref": "#/definitions/status"
                                                    }
                                                },
                                                "allOf": [
                                                    {
                                                        "if": {
                                                            "required": [
                                                                "status"
                                                            ],
                                                            "properties": {
                                                                "status": {
                                                                    "required": [
                                                                        "value"
                                                                    ],
                                                                    "properties": {
                                                                        "value": {
                                                                            "const": "obsolete"
                                                                        }
                                                                    }
                                                                }
                                                            }
                                                        },
                                                        "then": true,
                                                        "else": {
                                                            "required": [
                                                                "description"
                                                            ]
                                                        }
                                                    }
                                                ],
                                                "additionalProperties": false
                                            }
                                        ]
                                    }
                                },
                                "unit": {
                                    "type": "string"
                                }
                            },
                            "required": [
                                "key"
                            ],
                            "allOf": [
                                {
                                    "$comment": "Obsolete keywords only need 'key' and 'status'; all other keywords must define 'value_type' and 'description'.",
                                    "if": {
                                        "required": [
                                            "status"
                                        ],
                                        "properties": {
                                            "status": {
                                                "required": [
                                                    "value"
                                                ],
                                                "properties": {
                                                    "value": {
                                                        "const": "obsolete"
                                                    }
                                                }
                                            }
                                        }
                                    },
                                    "then": true,
                                    "else": {
                                        "required": [
                                            "value_type",
                                            "description"
                                        ]
                                    }
                                },
                                {
                                    "if": {
                                        "required": [
                                            "value_type"
                                        ],
                                        "properties": {
                                            "value_type": {
                                                "const": "enum"
                                            }
                                        }
                                    },
                                    "then": {
                                        "required": [
                                            "enum_values"
                                        ],
                                        "properties": {
                                            "default_value": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "string"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "int"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "integer"
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "float"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "number"
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "intbool"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "integer"
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "path"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "required": [
                                            "value_type"
                                        ],
                                        "properties": {
                                            "value_type": {
                                                "const": "intenum"
                                            }
                                        }
                                    },
                                    "then": {
                                        "required": [
                                            "enum_values"
                                        ],
                                        "properties": {
                                            "default_value": {
                                                "type": "integer"
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "list[path]"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "list[string]"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "array",
                                                "items": {
                                                    "type": "string"
                                                }
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "list[float]"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "array",
                                                "items": {
                                                    "type": "number"
                                                }
                                            }
                                        }
                                    }
                                },
                                {
                                    "if": {
                                        "properties": {
                                            "value_type": {
                                                "const": "datetime",
                                                "pattern": "^\\d{8}(\\d{6})?$"
                                            }
                                        }
                                    },
                                    "then": {
                                        "properties": {
                                            "default_value": {
                                                "type": "string"
                                            }
                                        }
                                    }
                                }
                            ],
                            "additionalProperties": false
                        }
                    }
                },
                "required": [
                    "name",
                    "description",
                    "is_unique",
                    "ini_properties"
                ],
                "additionalProperties": false
            }
        }
    },
    "required": [
        "file_version",
        "file_format_version",
        "file_format_type",
        "description",
        "ini_sections"
    ],
    "additionalProperties": false
}