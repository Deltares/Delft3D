FROM containers.deltares.nl/mcr-proxy/windows/server:ltsc2025 AS base

# Set powershell as shell
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'Continue'; $verbosePreference='Continue';"]

# Enable long pathnames
RUN reg add "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v "LongPathsEnabled" /t REG_DWORD /d 1 /f

# Use fixed locations for uv, its managed Python, and the Python executables
ENV UV_INSTALL_DIR="C:\\uv"
ENV UV_PYTHON_INSTALL_DIR="C:\\uv\\python"
ENV UV_PYTHON_BIN_DIR="C:\\uv\\bin"
ENV UV_CACHE_DIR="C:\\uv\\cache"

ARG UV_VERSION=0.13.6
RUN irm https://astral.sh/uv/${UV_VERSION}/install.ps1 | iex

# Add uv and the Python executables to the machine PATH (persists at container runtime)
RUN $machinePath = [Environment]::GetEnvironmentVariable('Path', 'Machine'); \
    [Environment]::SetEnvironmentVariable('Path', 'C:\uv;C:\uv\bin;' + $machinePath, 'Machine')

# Install Python; --default also creates the 'python' and 'python3' executables
RUN $env:Path = 'C:\uv;C:\uv\bin;' + $env:Path; \
    uv python install 3.14 --default; exit $LASTEXITCODE

ENV UV_TOOL_DIR="C:\\uv\\tools"
ENV UV_TOOL_BIN_DIR="C:\\uv\\bin"

# Perform testbench installation in new build stage.
# This extra stage prevents UV_INDEX_DELTARES_USERNAME and UV_INDEX_DELTARES_PASSWORD from leaking into the final image.
# Unfortunately, secret mounts are not supported when building these windows images.
# In addition, this prevents the uv image cache from ending up in the final image. 
FROM base AS testbench-install

ARG UV_INDEX_DELTARES_USERNAME
ARG UV_INDEX_DELTARES_PASSWORD
ARG DELTARES_TESTBENCH_VERSION=4.0.0rc2
ARG PYPI_INDEX_URL=https://internal-artifacts.deltares.nl/repository/python-internal/simple/

RUN uv tool install "deltares-testbench==$env:DELTARES_TESTBENCH_VERSION" --index "deltares=$env:PYPI_INDEX_URL"

FROM base AS final

COPY --from=testbench-install C:/uv/tools/ C:/uv/tools/
COPY --from=testbench-install C:/uv/bin/testbench.exe C:/uv/bin/testbench.exe

ENTRYPOINT [ "testbench" ]