# escape=`
FROM containers.deltares.nl/mcr-proxy/windows/server:ltsc2025

# Set PowerShell as the default shell.
SHELL ["powershell", "-Command", "$ErrorActionPreference = 'Stop'; $ProgressPreference = 'Continue'; $verbosePreference='Continue';"]

# Enable long pathnames.
RUN reg add "HKLM\SYSTEM\CurrentControlSet\Control\FileSystem" /v "LongPathsEnabled" /t REG_DWORD /d 1 /f

# Download and install the Windows SDK 10.0.22621.5040 (provides signtool.exe) for windows 11, April 2025 (compatible with windows server 2022).
# https://learn.microsoft.com/en-us/windows/apps/windows-sdk/downloads
RUN Invoke-WebRequest -Uri 'https://go.microsoft.com/fwlink/?linkid=2311806' -OutFile 'C:\winsdksetup.exe' -UseBasicParsing; `
    Start-Process -FilePath 'C:\winsdksetup.exe' -ArgumentList '/features OptionId.DesktopCPPx64 /installpath C:\WinSDK /q /norestart' -Wait; `
    Remove-Item 'C:\winsdksetup.exe'

# Download and install the Visual C++ Redistributable 2022 x64 (provides vcomp140.dll).
RUN Invoke-WebRequest -Uri 'https://aka.ms/vs/17/release/vc_redist.x64.exe' -OutFile 'C:\vc_redist.x64.exe' -UseBasicParsing; `
    Start-Process -FilePath 'C:\vc_redist.x64.exe' -ArgumentList '/install /passive /norestart' -Wait; `
    Remove-Item 'C:\vc_redist.x64.exe'

# Download and install Python 3.12.10.
RUN Invoke-WebRequest -Uri 'https://www.python.org/ftp/python/3.12.10/python-3.12.10-amd64.exe' -OutFile 'C:\python.exe' -UseBasicParsing; `
    Start-Process -FilePath 'C:\python.exe' -ArgumentList '/quiet InstallAllUsers=1' -Wait; `
    Remove-Item 'C:\python.exe'
RUN New-Item -ItemType SymbolicLink -Path 'C:\Program Files\Python312\python3.exe' -Target 'C:\Program Files\Python312\python.exe'

# Add signtool.exe and Python to PATH.
# NOTE: setx truncates at 1024 chars; use SetEnvironmentVariable instead.
# Dynamically find the signtool.exe directory so the SDK version number is not hardcoded.
RUN $signtool = Get-ChildItem -Path 'C:\WinSDK' -Recurse -Filter 'signtool.exe' | `
        Where-Object { $_.FullName -match 'x64' } | `
        Select-Object -First 1; `
    [Environment]::SetEnvironmentVariable('PATH', $Env:PATH + ';' + $signtool.DirectoryName + ';C:\Program Files\Python312\;C:\Program Files\Python312\Scripts\', 'Machine')
