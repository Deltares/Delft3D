{
    "name": "DFlow FM: {{TEST_CASE_NAME}}",
    "type": "cppdbg",
    "request": "launch",
    "MIMode": "gdb",
    "miDebuggerPath": "gdb-oneapi",
    "program": "${workspaceFolder}/build_{{BUILD_CONFIG}}_{{BUILD_TYPE}}/install/bin/dflowfm",
    "args": [
        "{{MDU_FILE}}"
    ],
    "cwd": "${workspaceFolder:Delft3D}/test/deltares_testbench/data/cases/{{TEST_CASE_PATH}}/input_work",
    "stopAtEntry": false,
    "externalConsole": false,
    "environment": [],
    "setupCommands": [
        {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
        },
        {
          "description": "Turn off target-async",
          "text": "set target-async off",
          "ignoreFailures": false
        },
        {
          "description": "Set language to Fortran",
          "text": "set language fortran",
          "ignoreFailures": false
        }
    ]
}
