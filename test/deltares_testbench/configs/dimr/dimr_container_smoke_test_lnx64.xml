<?xml version="1.0" encoding="iso-8859-1"?>
<deltaresTestbench_v3 xmlns="http://schemas.deltares.nl/deltaresTestbench_v3" xmlns:xi="http://www.w3.org/2001/XInclude" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://schemas.deltares.nl/deltaresTestbench_v3 http://content.oss.deltares.nl/schemas/deltaresTestbench_v3-2.00.xsd">
  <config>
    <localPaths>
      <testCasesDir>./data/cases</testCasesDir>
      <enginesDir>./data/engines</enginesDir>
      <referenceDir>./data/reference_results</referenceDir>
    </localPaths>
    <locations>
      <location name="reference_results">
        <credential ref="commandline"></credential>
        <root>{server_base_url}/references</root>
      </location>
      <location name="cases">
        <credential ref="commandline"></credential>
        <root>{server_base_url}/cases</root>
      </location>
      <location name="reference_engines">
        <credential ref="commandline"></credential>
        <root>./data/engines</root>
      </location>
      <location name="engines_to_compare">
        <credential ref="commandline"></credential>
        <root>./data/engines</root>
      </location>
      <location name="local">
        <root>./data/engines</root>
      </location>
    </locations>
  </config>
  <!-- ======================================================================== -->
  <programs>
    <!--
        The order is important. Start with the following programs:
            command_prompt
            mpi
        -->
    <program name="command_prompt">
      <path>/bin/bash</path>
      <arguments>
        <argument>-c</argument>
      </arguments>
    </program>
    <program addSearchPaths="true" excludeSearchPathsContaining="share/delft3d/esmf" logOutputToFile="true" name="dimr" programStringRemoveQuotes="true">
      <location ref="reference_engines" type="reference">
        <from>lnx64</from>
      </location>
      <location ref="local" type="check">
        <from>teamcity_artifacts/lnx64</from>
        <!-- just the first part of the directory structure, wil be file by TeamCity -->
      </location>
      <path>bin/dimr</path>
      <environments>
        <environment name="OMP_NUM_THREADS" type="raw">1</environment>
      </environments>
    </program>
  </programs>
  <!-- ======================================================================== -->
  <defaultTestCases>
    <testCase name="dimr_trunk">
      <programs>
        <program ref="dimr">
          <arguments>
            <argument>dimr_config.xml</argument>
          </arguments>
        </program>
      </programs>
      <location ref="cases" type="input">
        <!-- if "to" is not specified, "from" is used as target -->
        <from>.</from>
      </location>
      <location ref="reference_results" type="reference">
        <from>win64</from>
      </location>
      <maxRunTime>14400.0</maxRunTime>
      <!-- seconds -->
    </testCase>
  </defaultTestCases>
  <!-- ======================================================================== -->
    <xi:include href="../../include/dimr_smoke_test_cases.xml"/>
  <!-- ======================================================================== -->
</deltaresTestbench_v3>
