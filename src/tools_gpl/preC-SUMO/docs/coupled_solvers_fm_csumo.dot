digraph CoupledSystem {

  rankdir=TB;
  splines=true;
  nodesep=0.5;
  ranksep=0.6;
  fontname="Helvetica";

  node [shape=box, style=rounded, fontname="Helvetica"];

  /* -------------------------
     D-FlowFM Side
  --------------------------*/
  subgraph cluster_FM {
    label="D-FlowFM";
    style=dashed;

    FM [label="D-FlowFM", style="rounded,filled", fillcolor="#6C9BCF"];
    FM_preCICE_adapter [label="FM preCICE adapter\n(interface)", fillcolor="#A5B51B", style="rounded,filled"];

    FM -> FM_preCICE_adapter;
  }

  /* -------------------------
     Coupling Core
  --------------------------*/
  PreCICEConfig [label="preCICE Config\n(XML)", shape=note];

  PreCICEConfig -> FM_preCICE_adapter [style=dashed];

  /* -------------------------
     preC-SUMO Side
  --------------------------*/
  subgraph cluster_preC_SUMO {
    label="preC-SUMO Side";
    style=dashed;

    preC_SUMO_adapter [label="Adapter\n(interface)", fillcolor="#A5B51B", style="rounded,filled"];
    preC_SUMO [label="preC-SUMO", style="rounded,filled", fillcolor="#F26422"];
    
    FF2NF [label="FF2NF Files\n(Farfield→Nearfield)", shape=note, fillcolor="#FFE6CC"];
    NF2FF [label="NF2FF Files\n(Nearfield→Farfield)", shape=note, fillcolor="#CCE6FF"];

    preC_SUMO_adapter -> preC_SUMO;
    preC_SUMO -> FF2NF [label="generates"];
    NF2FF -> preC_SUMO [label="consumes"];
  }
  
  PreCICEConfig -> preC_SUMO_adapter [style=dashed];

  /* -------------------------
     External C_SUMO Application
  --------------------------*/
  CSUMO_App [label="C-SUMO\n(Nearfield calc)", style="rounded,filled", fillcolor="#1285f0", fontcolor="white"];
  
  FF2NF -> CSUMO_App [label="consumed by"];
  CSUMO_App -> NF2FF [label="produces"];

  FM_preCICE_adapter -> preC_SUMO_adapter [dir=both, label="Coupling Data\nExchange"];
}
