"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sources_z_min", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sources_z_max", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sources_sinks_discharge", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sources_momentum_magnitude_weighted", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sources_momentum_direction", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label=C01, tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label=C02, tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label=C03, tooltip=scalar, color="#DE8F05"];
