"m2n-fm-preC-SUMO" -> "preC-SUMO" [lhead="cluster_preC-SUMO", dir=both, color="#DE8F05"];
"cpl-fm-preC-SUMO" -> "fm" [lhead="cluster_fm", taillabel="first", color="#0173B2"];
"cpl-fm-preC-SUMO" -> "preC-SUMO" [lhead="cluster_preC-SUMO", taillabel="second", color="#DE8F05"];
"fm-fm_flow_cells" -> "preC-SUMO-fm_flow_cells" [label="sea_floor_depth_below_sea_surface", tooltip="scalar initialized", color="#0173B2", style=bold];
