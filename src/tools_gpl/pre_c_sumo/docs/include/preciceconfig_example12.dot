"preC-SUMO-csumo_3d_nodes" -> "preC-SUMO" [label=C10, tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sinks_x", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sinks_y", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sinks_z_min", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sinks_z_max", tooltip=scalar, color="#DE8F05"];
"preC-SUMO" -> "preC-SUMO-sources_sinks_nodes" [label="sources_x", tooltip=scalar, color="#DE8F05"];
