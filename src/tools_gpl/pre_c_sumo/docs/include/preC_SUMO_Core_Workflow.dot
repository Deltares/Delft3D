// Detailed workflow of preC-SUMO core processes
// Shows the sequence of tasks and data flow within the preC-SUMO adapter

digraph preCSUMOWorkflow {

  rankdir=TB;
  splines=true;
  nodesep=0.6;
  ranksep=0.8;
  fontname="Helvetica";
  fontsize=10;

  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9];

  /* -------------------------
     Input Sources
  --------------------------*/
  CSUMOConfig [label="CSUMO Config.xml\n(Diffuser + Ambient\nLocations)", shape=note, fillcolor="#CCE6FF", style=filled];
  ProC_Adapter [label="preC-SUMO Adapter\n(preCICE Interface)", shape=box, fillcolor="#A5B51B", style="rounded,filled"];

  /* -------------------------
     Core Tasks
  --------------------------*/
  subgraph cluster_workflow {
    label="preC-SUMO Core Workflow";
    style="rounded,filled";
    fillcolor="#FFE6E6";
    
    task1 [label="1. Read CSUMO Config.xml\n(Diffuser + Ambient\nLocations)", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];
    
    task2 [label="2. Receive Ambient Data\nat Locations from\nAdapter (preCICE)", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];
    
    task3 [label="3. Write FF2NF.xml\n(Far-field → Near-field\nConditions)", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];
    
    task4 [label="4. External C-SUMO\nNearfield Calculation\n(Produces NF2FF.xml)", shape=box, fillcolor="#1285f0", fontcolor="white", style="rounded,filled"];
    
    task5 [label="5. Read NF2FF.xml\n(Near-field → Far-field\nResults)", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];
    
    task6 [label="6. DESA Routine\n(Create Source/Sink\nStructures)", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];
    
    task7 [label="7. Send Source/Sink\nCloud to FM\n(via preCICE)", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];
    
    task1 -> task2 [label="Locations"];
    task2 -> task3 [label="Ambient data"];
    task3 -> task4 [label="FF2NF.xml"];
    task4 -> task5 [label="NF2FF.xml"];
    task5 -> task6 [label="NF results"];
    task6 -> task7 [label="Point cloud"];
  }

  /* -------------------------
     Output
  --------------------------*/
  FMAdapter [label="FM Adapter\n(preCICE Receiver)", shape=box, fillcolor="#A5B51B", style="rounded,filled"];

  /* -------------------------
     Data Flow
  --------------------------*/
  CSUMOConfig -> task1 [label="reads"];
  ProC_Adapter -> task2 [label="provides data"];
  task7 -> FMAdapter [label="sends data"];

  /* -------------------------
     External Coupling
  --------------------------*/
  ExtCSUMO [label="External C-SUMO App\n(Nearfield Calculator)", shape=box, fillcolor="#1285f0", fontcolor="white", style="rounded,filled"];
  task3 -> ExtCSUMO [label="  FM conditions"];
  ExtCSUMO -> task4 [label="  nearfield plume"];
}
