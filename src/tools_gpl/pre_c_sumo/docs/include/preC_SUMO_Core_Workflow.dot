// Detailed workflow of preC-SUMO initialization and coupling windows

digraph preCSUMOWorkflow {

  rankdir=TB;
  splines=true;
  nodesep=0.6;
  ranksep=0.8;
  fontname="Helvetica";
  fontsize=10;

  node [shape=box, style=rounded, fontname="Helvetica"];
  edge [fontname="Helvetica", fontsize=9];

  /* -------------------------
     Input Sources
  --------------------------*/
  CSUMOConfig [label="CSUMO Config.xml\n(diffusers + ambient\nlocations)", shape=note, fillcolor="#CCE6FF", style=filled];
  ProC_Adapter [label="preC-SUMO Adapter\n(preCICE interface)", shape=box, fillcolor="#A5B51B", style="rounded,filled"];

  /* -------------------------
     Initialization
  --------------------------*/
  subgraph cluster_workflow {
    label="preC-SUMO Initialization";
    style="rounded,filled";
    fillcolor="#FFE6E6";

    task1 [label="readSettingsFile()", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_read_csumo_settings_file", tooltip="Open readSettingsFile docs"];

    task2 [label="Register sampling meshes", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];

    task3 [label="Wait for and read\ninitial NF2FF files", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_read_nf2ff", tooltip="Read initial NF2FF data before participant initialization"];

    task4 [label="Convert initial results\nand register sink/source mesh", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_convert_nf_to_sink_source_connections", tooltip="Determine initial sink/source mesh from NF2FF data"];

    task5 [label="Check initial data requirement\nand initialize participant", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];

    task1 -> task2;
    task2 -> task3;
    task3 -> task4;
    task4 -> task5;
  }

  /* -------------------------
     Coupling Window
  --------------------------*/
  subgraph cluster_coupling {
    label="Each preCICE Coupling Window";
    style="rounded,filled";
    fillcolor="#FFF6E8";

    task6 [label="receiveFFData()", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_receive_ff_data", tooltip="Open receiveFFData docs"];

    task7 [label="write FF2NF files", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_write_ff2nf", tooltip="Open FF2NFWriter::write docs"];

    task8 [label="C-SUMO near-field", shape=box, fillcolor="#1285f0", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_write_ff2nf", tooltip="FF2NF to NF2FF exchange"];

    task9 [label="wait + read NF2FF", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_read_nf2ff", tooltip="Open NF2FF read docs"];

    task10 [label="convertCSumoToPrecice()", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_convert_nf_to_sink_source_connections", tooltip="Open conversion docs"];

    task11 [label="writeSinkSourceConnections()", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled", URL="\\ref pre_c_sumo_sink_source_connections_write_to_precice", tooltip="Open writeSinkSourceConnections docs"];

    task12 [label="advance()", shape=box, fillcolor="#F26422", fontcolor="white", style="rounded,filled"];

    task6 -> task7;
    task7 -> task8;
    task8 -> task9;
    task9 -> task10;
    task10 -> task11;
    task11 -> task12;
    task12 -> task6 [constraint=false];
  }
  task5 -> task6;

  /* -------------------------
     Output
  --------------------------*/
  FMAdapter [label="FM Adapter\n(preCICE receiver)", shape=box, fillcolor="#A5B51B", style="rounded,filled"];

  /* -------------------------
     Data Flow
  --------------------------*/
  CSUMOConfig -> task1;
  ProC_Adapter -> task2;
  ProC_Adapter -> task6;
  task11 -> FMAdapter;
  ExtCSUMO -> task3;
  ExtCSUMO -> task9;

  /* -------------------------
     External Coupling
  --------------------------*/
  ExtCSUMO [label="External C-SUMO\nnear-field solver", shape=box, fillcolor="#1285f0", fontcolor="white", style="rounded,filled"];
  task7 -> ExtCSUMO;
}
