digraph preCSUMOSwimlanes {
  rankdir=TB;
  newrank=true;
  compound=true;
  splines=ortho;
  nodesep=0.32;
  ranksep=0.55;
  fontname="Helvetica";
  fontsize=10;

  node [shape=box, style="rounded,filled", fontname="Helvetica", fontsize=9, color="#555555", fillcolor="#FFFFFF"];
  edge [fontname="Helvetica", fontsize=8, color="#444444"];

  subgraph cluster_precice {
    label="preCICE";
    color="#A5B51B";
    style="rounded";

    precice [
      label="preCICE",
      shape=box,
      style="rounded,filled",
      color="#A5B51B",
      fillcolor="#EEF3C9",
      penwidth=1.4,
      width=1.5,
      height=0.55,
      group="precice",
      URL="https://precice.org/docs.html",
      tooltip="preCICE coupling library"
    ];
  }

  subgraph cluster_precsumo {
    label="preC-SUMO";
    color="#F26422";
    style="rounded";

    node [group="precsumo"];

    s0 [label="settings\nreadCsumoSettingsFile()", fillcolor="#FFE3D1", URL="\\ref pre_c_sumo::readCsumoSettingsFile", tooltip="Open readCsumoSettingsFile docs"];
    s1 [label="mesh\nsetup", fillcolor="#FFE3D1", URL="\\ref anonymous_namespace{pre_c_sumo_lib.cpp}::getMesh2D3D()", tooltip="Set up meshes for preCICE exchange"];
    s2 [label="wait + read\nNF2FF", fillcolor="#FFE3D1", URL="\\ref pre_c_sumo::waitForNF2FFFiles", tooltip="Open initial NF2FF bootstrap docs"];
    s3 [label="init\nparticipant", fillcolor="#FFE3D1", URL="\\ref pre_c_sumo::run()", tooltip="Open participant initialization docs"];

    l0 [label="receiveFFData()", fillcolor="#FFF6E8", URL="\\ref pre_c_sumo::receiveFFData", tooltip="Open receiveFFData docs"];
    l1 [label="writeFF2NF()", fillcolor="#FFF6E8", URL="\\ref pre_c_sumo::writeFF2NFFiles", tooltip="Open writeFF2NFFiles docs"];
    l2 [label="waitNF2FF()", fillcolor="#FFF6E8", URL="\\ref pre_c_sumo::waitForNF2FFFiles", tooltip="Open waitForNF2FFFiles docs"];
    l3 [label="readNF2FF()", fillcolor="#FFF6E8", URL="\\ref pre_c_sumo::readNF2FFFiles", tooltip="Open readNF2FFFiles docs"];
    l4 [label="convert()", fillcolor="#FFF6E8", URL="\\ref pre_c_sumo::convertNFtoConnectedSinkSources", tooltip="Open convertNFtoConnectedSinkSources docs"];
    l5 [label="source-sink\nwrite", fillcolor="#FFF6E8", URL="\\ref pre_c_sumo_connected_sink_sources_write_to_precice", tooltip="Open write_to_precice docs"];
    l6 [label="advance()", fillcolor="#FFF6E8", URL="\\ref pre_c_sumo::run()", tooltip="Open run() loop docs"];
    lane_left [label="", shape=point, width=0.01, height=0.01, style=invis];

    s0 -> s1 -> s2 -> s3 -> l0 -> l1 -> l2 -> l3 -> l4 -> l5 -> l6;
    lane_left -> l0 [style=invis, weight=120];
    l6 -> l0 [color="#666666"];
  }

  { rank=same; precice; lane_left; l0; }

  precice -> lane_left [style=invis, weight=240, minlen=1];

  subgraph cluster_csumo {
    label="C-SUMO";
    color="#1285F0";
    style="rounded";

    c0 [label="FF2NF Files", fillcolor="#DDEBFF", tooltip="Produced by writeFF2NFFiles"];
    c1 [label="Near-field Calculation", fillcolor="#DDEBFF",  tooltip="External step consuming FF2NF and generating NF2FF files"];
    c2 [label="NF2FF Files", fillcolor="#DDEBFF", tooltip="Consumed by readNF2FFFiles"];
    c0 -> c1 -> c2;
  }

  precice:e -> l0:w [constraint=false, xlabel="readData()"];
  l5:w -> precice:se [constraint=false, xlabel="mesh reset"];
  l5:w -> precice:se [constraint=false, xlabel="writeData()"];

  l1 -> c0 [lhead=cluster_csumo];
  c2 -> l2 [ltail=cluster_csumo];
}

