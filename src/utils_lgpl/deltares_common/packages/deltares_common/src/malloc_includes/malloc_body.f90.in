  subroutine @PROC_NAME@(arr, new_u_index, lindex, stat, fill, shift, keepExisting)
      implicit none
      @DTYPE@, @DATTR@, intent(inout) :: arr @DRANK@
      @DINDEX@, intent(in)            :: new_u_index
      @DINDEX@, intent(in), optional  :: lindex
      integer, intent(out), optional  :: stat
      @DTYPE@, intent(in), optional   :: fill
      @DINDEX@, intent(in), optional  :: shift
      logical, intent(in), optional   :: keepExisting

      @DTYPE_TEMP@, @DATTR@ :: temp @DRANK@
      @DINDEX@ :: old_l_index, old_u_index
      @DINDEX@ :: new_l_index
      @DINDEX@ :: data_l_index, data_u_index
      @DINDEX@ :: shift_
      integer :: stat_
      logical :: keepExisting_
      logical :: allocated_old

      new_l_index = @LINDEX_ONE@
      shift_ = @SHIFT_ZERO@
      keepExisting_ = .true.
      stat_ = 0

      if (present(lindex)) new_l_index = lindex
      if (present(shift)) shift_ = shift
      if (present(keepExisting)) keepExisting_ = keepExisting

      allocated_old = @IS_ALLOCATED@

      if (allocated_old) then
         @GET_BOUNDS@

         if (@BOUNDS_UNCHANGED@) then
            if (.not. keepExisting_ .and. present(fill)) then
               arr = fill
            end if
            return
         end if
      end if

      ! Reallocation required
      @ALLOCATE_TEMP@
      if (stat_ /= 0) then
         goto 999
      end if
      if (present(fill)) temp = fill

      if (keepExisting_ .and. allocated_old) then
         data_l_index = max(old_l_index + shift_, new_l_index)
         data_u_index = min(old_u_index + shift_, new_u_index)
         if (@OVERLAP_NONEMPTY@) then
            @COPY_SECTION@
         end if
      end if

      @MOVE_ALLOC@
      999   continue
      if (present(stat)) stat = stat_
   end subroutine @PROC_NAME@
