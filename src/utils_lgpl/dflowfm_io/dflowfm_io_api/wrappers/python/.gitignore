__pycache__/
*.pyc

# Generated code: produced by scripts/ (from the C header and mdu.json) during the build. A build is
# required to use the package anyway (it also stages the native library), so these are not committed.
src/dflowfm_io/mdu/model.py
src/dflowfm_io/mdu/schema.py

# Local scratch / spike scripts under tests/ — not part of the committed test suite.
tests/spike_*.py
tests/parity_*.py
tests/compare_*.py

# Wheel build outputs.
build/
dist/
*.egg-info/

# The native dflowfm_io_api library is a build artifact: CMake builds it and stages it into
# src/dflowfm_io/_lib/, from where the loader and the wheel pick it up. Never commit it.
*.dll
*.so
*.dylib
