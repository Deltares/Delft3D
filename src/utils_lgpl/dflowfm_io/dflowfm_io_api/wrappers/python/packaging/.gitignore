# Build artifacts — never committed. The wheel and its bundled native library are produced by the
# build (the native lib is staged into src/dflowfm_io/_lib/ by CMake), not tracked in the repo.
build/
dist/
*.egg-info/
__pycache__/

# Native libraries staged into the package for bundling.
src/dflowfm_io/_lib/*.dll
src/dflowfm_io/_lib/*.so
src/dflowfm_io/_lib/*.dylib
src/dflowfm_io/_lib/*.pyd
