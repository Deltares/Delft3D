! Detrmine sign of discharges: whether positive discharge means inflow or outflow (for nesting of discharge boundaries)
module m_det_sign_discharge

   implicit none

   private

   public :: det_sign_discharge

contains

   subroutine det_sign_discharge(pliFile,factor)
      use precision, only: dp

      character(len=*), intent(in) :: pliFile
      real(kind=dp)   , intent(out):: factor
      factor = 1.0_dp
      write(*,*) pliFile
   end subroutine det_sign_discharge
end module m_det_sign_discharge

