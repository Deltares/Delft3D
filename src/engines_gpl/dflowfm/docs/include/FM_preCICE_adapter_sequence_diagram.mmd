sequenceDiagram
    autonumber
    participant FM as FM Adapter
    participant P as preCICE

    rect rgba(56, 139, 253, 0.12)
    Note over FM,P: INITIALIZATION - precice_adapter_initialize() - once
    alt MPI communicator supplied
        FM->>P: precicef_create_with_communicator()
    else No communicator supplied
        FM->>P: precicef_create()
    end
    FM->>P: precicef_set_vertices(fm_flow_cells)
    FM->>P: precicef_set_vertices(fm_flow_cells_3d)
    FM->>P: precicef_get_mesh_dimensions(sources_sinks_nodes)
    FM->>P: precicef_set_mesh_access_region(sources_sinks_nodes)
    Note over FM,P: Set bounding box [-1, 1, -1, 1] for access to the shared source/sink mesh
    FM->>P: precicef_requires_initial_data()
    alt Initial outgoing data required
        FM->>P: precicef_write_data(FM fields on 2D and 3D meshes)
    end
    FM->>P: precicef_initialize()
    Note over FM,P: FM can now read incoming data, but the received mesh may be empty
    FM->>P: precicef_get_mesh_vertex_size(sources_sinks_nodes)
    FM->>P: precicef_get_mesh_vertex_ids_and_coordinates(sources_sinks_nodes)
    FM->>P: precicef_read_data(source/sink quantities, relative time = 0)
    Note over FM: Add data to FM administration and reset elapsed time
    end

    rect rgba(63, 185, 80, 0.12)
    Note over FM,P: CYCLIC UPDATE - precice_adapter_update(timestep)
    loop Called after each FM user timestep
        FM->>P: precicef_is_coupling_ongoing()
        alt Coupling ongoing
            FM->>P: precicef_get_max_time_step_size()
            Note over FM: Accumulate elapsed FM user timesteps
            alt Coupling boundary reached
                FM->>P: precicef_is_time_window_complete()
                alt Returns true
                    FM->>P: precicef_reset_mesh(fm_flow_cells_3d)
                    FM->>P: precicef_set_vertices(fm_flow_cells_3d, updated coordinates)
                else Returns false
                    Note over FM: Keep registered mesh and continue exchange
                end
                FM->>P: precicef_write_data(FM fields on 2D and 3D meshes)
                FM->>P: precicef_advance(max_timestep)
                FM->>P: precicef_get_mesh_vertex_size(sources_sinks_nodes)
                FM->>P: precicef_get_mesh_vertex_ids_and_coordinates(sources_sinks_nodes)
                FM->>P: precicef_read_data(source/sink quantities, relative time = 0)
                Note over FM: Add new data to FM administration and reset elapsed time
            else Boundary not reached
                Note over FM: Return without exchanging data
            end
        else Coupling finished
            Note over FM: Return from update
        end
    end
    end

    rect rgba(210, 153, 34, 0.12)
    Note over FM,P: FINALIZATION - precice_adapter_finalize() - once
    FM->>P: precicef_finalize()
    end
