!-------------------------------------------------------------------------------
    type gd_ice
!
       real(fp) :: albedo_snow
       real(fp) :: albedo_ice
       real(fp) :: albedo_wat
       real(fp) :: cp_snow         !! specific heat for snow
       real(fp) :: cp_ice          !! specific heat for ice
       real(fp) :: k_snow          !! conductivity  for snow
       real(fp) :: k_ice           !! conductivity  for ice
       real(fp) :: lh_snow         !! latent heat for snow
       real(fp) :: lh_ice          !! latent heat for ice
       real(fp) :: rho_ice         !! density of ice
       real(fp) :: rho_snow        !! density of snow
       integer  :: lice            !! constituent number that represents ice
       integer  :: lsnow           !! constituent number that represents snow
       character(10) :: ice_model  !! type of ice model (Deltares or KNMI)
       logical  :: dyn_ice         !! flag for horizontal transport of ice 
       logical  :: prs_ice         !! flag for ice pressure on water
       logical  :: his_ice         !! ice output on history file
!
    end type gd_ice
!
