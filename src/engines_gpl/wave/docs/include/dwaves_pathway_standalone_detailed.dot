digraph standalone_communication {
    graph [label="Standalone: saved fields, no live Delft3D4 or D-Flow FM engine", labelloc=t,
           fontsize=18, fontname="Helvetica", rankdir=TB, nodesep=0.5,
           ranksep=0.5, pad=0.3, bgcolor="white"];
    node [shape=box, style="rounded,filled", fillcolor="#FCF5E6",
          color="#7890A2", fontname="Helvetica", fontsize=11];
    edge [fontname="Helvetica", fontsize=10, color="#48647A"];

    saved [shape=cylinder, fillcolor="#FFF9ED",
           label="Existing communication files\nDelft3D4 NEFIS / D-Flow FM NetCDF"];
    forcing [shape=note, fillcolor="#F5F7F8",
             label="MDW / boundary / forcing files"];
    subgraph cluster_wave {
        label="D-Waves: calculation schedule and file I/O"; color="#B28B42";
        init [label="Initialize grids and mappings"];
        time [label="Select calculation time\n(route-dependent schedule)"];
        inputs [label="Prepare inputs on next SWAN grid\nread/remap saved hydrodynamic fields if selected"];
        swan [label="Run SWAN for this grid\nseparate executable or MPI library"];
        collect [label="Read results; accumulate output on the\nhydrodynamic grid if WriteCOM"];
        nests [shape=diamond, fillcolor="white", label="More SWAN grids?"];
        outputs [label="Write configured D-Waves results\nand optional com-file wave fields"];
        times [shape=diamond, fillcolor="white", label="More selected times?"];
        done [label="Finalize"];
        init -> time -> inputs;
        inputs -> swan [label="staged input files"];
        swan -> collect [label="SWAN output files"];
        collect -> nests;
        nests -> inputs [label="yes: next grid / nest", constraint=false];
        nests -> outputs [label="no"];
        outputs -> times;
        times -> time [label="yes", constraint=false];
        times -> done [label="no"];
    }
    saved -> init [label="grid geometry"];
    saved -> inputs [label="saved hydrodynamic fields"];
    forcing -> inputs [label="configured forcing"];
    outputs -> saved [label="wave fields: WriteCOM only", constraint=false];
    diagram_credit [shape=plaintext, fontsize=8,
                    label="Created with Copilot from prompts, using existing code as reference."];
    {rank=sink; diagram_credit;}
    done -> diagram_credit [style=invis];
}
